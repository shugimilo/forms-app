@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mt-5">
    <h1 class="display-4 mb-4">Welcome</h1>
    <p class="mb-5">
        Manage users and forms easily.
        Learn more about <a href="https://learn.microsoft.com/aspnet/core">ASP.NET Core</a>.
    </p>

    <div class="d-flex justify-content-center gap-3">
        <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Register</a>
        <a class="btn btn-success btn-lg" asp-controller="Account" asp-action="Login">Login</a>
        <a class="btn btn-warning btn-lg" asp-controller="Users" asp-action="Index">Users</a>
    </div>
</div>
