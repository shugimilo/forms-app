@model FormsApp.Models.Option
@{
    ViewData["Title"] = "Delete Option";
}

<h2>Delete Option</h2>

<div class="alert alert-danger">
    <p>Are you sure you want to delete this option?</p>
    <h4>@Model.Text</h4>
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
    <img src="@Model.ImagePath" class="img-fluid rounded mb-3" alt="Option image" />
    }
</div>

<form asp-controller="Options" asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-controller="Questions" asp-action="Details" asp-route-id="@Model.QuestionId" class="btn btn-secondary">Cancel</a>
</form>
