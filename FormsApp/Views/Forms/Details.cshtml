@model FormsApp.Models.Form

@{
    ViewData["Title"] = "Form Details";
}

<h2>@ViewData["Title"]</h2>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.Title</h4>
        <p class="card-text">@Model.Description</p>
        <p><strong>Created At:</strong> @Model.CreatedAt.ToString("g")</p>
        <p><strong>Created By User ID:</strong> @Model.UserId</p>
        <p><strong>Requires Login:</strong> @(Model.RequireLogin ? "Yes" : "No")</p>
    </div>
    <h4>Questions</h4>

    @if (Model.Questions == null || !Model.Questions.Any())
    {
        <p>No questions yet for this form.</p>
    }
    else
    {
        <ul>
            @foreach (var q in Model.Questions)
            {
            <li>
                @q.Text
                <a asp-controller="Questions" asp-action="Edit" asp-route-id="@q.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                <a asp-controller="Questions" asp-action="Delete" asp-route-id="@q.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </li>
            }
        </ul>
    }

    <a asp-controller="Questions" asp-action="Create" asp-route-formId="@Model.Id" class="btn btn-primary btn-sm mt-2">
        Add New Question
    </a>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">Back to Forms</a>
