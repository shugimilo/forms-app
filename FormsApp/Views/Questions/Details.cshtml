@model FormsApp.Models.Question
@{
    ViewData["Title"] = "Question Details";
}

<h2>Question Details</h2>

<div class="card p-3 mb-3">
    <h4>@Model.Text</h4>
    <p><strong>Type:</strong> @Model.Type</p>
    
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img src="@Model.ImagePath" class="img-fluid rounded mb-3" alt="Question image" />
    }

    @if (Model.Type == "SingleChoice" || Model.Type == "MultipleChoice")
    {
        <div class="mb-3">
            <a asp-controller="Options" asp-action="Index" asp-route-questionId="@Model.Id" class="btn btn-outline-primary me-2">
                Manage Options
            </a>
            <a asp-controller="Options" asp-action="Create" asp-route-questionId="@Model.Id" class="btn btn-primary">
                Add Option
            </a>
        </div>

        @if (Model.Options != null && Model.Options.Any())
        {
            <h5>Options:</h5>
            <ul>
                @foreach (var opt in Model.Options)
                {
                    <li>@opt.Text</li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No options yet. Click "Add Option" to create one.</p>
        }
    }
</div>

<a asp-action="Index" asp-route-formId="@Model.FormId" class="btn btn-secondary mt-3">Back to List</a>
