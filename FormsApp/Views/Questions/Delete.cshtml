@model FormsApp.Models.Question
@{
    ViewData["Title"] = "Delete Question";
}

<h2>Delete Question</h2>

<div class="alert alert-danger">
    <h5>Are you sure you want to delete this question?</h5>
    <p><strong>@Model.Text</strong></p>
</div>

<form asp-controller="Questions" asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" asp-route-formId="@Model.FormId" class="btn btn-secondary">Cancel</a>
</form>
