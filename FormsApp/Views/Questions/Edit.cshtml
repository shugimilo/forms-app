@model FormsApp.Models.Question
@{
    ViewData["Title"] = "Edit Question";
}

<h2>Edit Question</h2>

<form asp-controller="Questions" asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="FormId" />

    <div class="form-group mb-3">
        <label asp-for="Text"></label>
        <input asp-for="Text" class="form-control" />
        <span asp-validation-for="Text" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Type"></label>
        <select asp-for="Type" class="form-select">
            <option value="ShortText">Short Text</option>
            <option value="LongText">Long Text</option>
            <option value="SingleChoice">Single Choice</option>
            <option value="MultipleChoice">Multiple Choice</option>
            <option value="Numeric">Numeric</option>
            <option value="Date">Date</option>
            <option value="Time">Time</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ImagePath"></label>
        <input asp-for="ImagePath" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" asp-route-formId="@Model.FormId" class="btn btn-secondary">Cancel</a>
</form>
